{
  "flow_id": "seith-warden-compliance-radar",
  "name": "SEITH-WARDEN v0.3.0-visual",
  "description": "Visual canvas: GraphLookup + Code ceiling_verify (green) + dual persona Router + HITL readback. 3 prompt terkunci 0.0/0.0/0.1 + PII re + dual-vector isolated + Sheets 9 kolom + webhook HIGH only. Visual layout for Langflow Desktop.",
  "version": "0.3.0-visual",
  "langflow_version": "1.3.2-desktop",
  "viewport": {"x": 0, "y": 0, "zoom": 0.7},
  "nodes": [
    {"id": "chat_input", "type": "ChatInput", "display": "Chat Input — audit_severity | draft_remediation", "position": {"x": 200, "y": 0}, "data": {"persona": "audit_severity|draft_remediation", "handles": {"output": "message"}},
     "style": {"border": "2px solid #4f46e5"}},
    {"id": "router_entry", "type": "Router", "display": "Router — Dual Persona", "position": {"x": 200, "y": 140}, "data": {"routes": ["audit_severity", "draft_remediation"], "handles": {"input": "message", "outputs": ["audit", "draft"]}},
     "style": {"border": "2px solid #f59e0b"}},
    {"id": "pii_code", "type": "Code", "display": "Code — PII Sanitize (green)", "position": {"x": 200, "y": 280}, "data": {"file": "tools/pii_sanitizer.py", "fn": "sanitize_sop_text", "order": "NIK→rekening→email", "color": "green", "handles": {"input": "text", "output": "clean_text"}}},
    {"id": "vector_sop", "type": "VectorStore", "display": "Vector SOP 800/150", "position": {"x": 0, "y": 420}, "data": {"collection": "collection_sop_internal", "chunk": "800/150 recursive", "embedding": "text-embedding-004", "store": "chroma-local", "source": "data/sop_dummy/sop_bunga_dummy.md", "handles": {"input": "clean_text", "output": "docs"}}},
    {"id": "vector_padk", "type": "VectorStore", "display": "Vector PADK hierarchical", "position": {"x": 400, "y": 420}, "data": {"collection": "collection_ojk_padk2026", "chunk": "hierarchical Bab→Pasal→Ayat", "embedding": "text-embedding-004", "store": "chroma-local", "source": "data/kb/padk_2026_curated.md", "handles": {"input": "clean_text", "output": "docs"}}},
    {"id": "graph_lookup", "type": "CustomComponent", "display": "GraphLookup — padk_graph.json (green)", "position": {"x": 380, "y": 900}, "data": {"file": "data/kb/padk_graph.json", "lookup": "pasal12 ayat1 0.1 vs ayat3 100", "citation": "PADK 12/PADK.05/2026 Bab III", "color": "green", "handles": {"input": "param", "output": "ceiling"}}},
    {"id": "code_ceiling", "type": "Code", "display": "Code — ceiling_verify (green deterministic)", "position": {"x": 20, "y": 900}, "data": {"file": "tools/ceiling_verify.py", "fn": "extract_percent|verify_ceiling", "deterministic": "Code not LLM math", "color": "green", "handles": {"input": "raw_percent", "output": "verified"}}},
    {"id": "ref_mapper", "type": "Prompt", "display": "SEITH-RefMapper 0.0", "position": {"x": 200, "y": 560}, "data": {"temp": 0.0, "prompt": "SEITH-RefMapper 0.0 — detect SEOJK→PADK grounded data/kb/padk_2026_curated.md strict JSON detected_references[] DEPRECATED|ACTIVE", "output": "detected_references[]", "grounding": "padk_2026_curated.md", "handles": {"inputs": ["docs_sop", "docs_padk"], "output": "references"}}},
    {"id": "rule_auditor", "type": "Prompt", "display": "SEITH-RuleAuditor 0.0 (extract raw% only)", "position": {"x": 200, "y": 700}, "data": {"temp": 0.0, "prompt": "SEITH-RuleAuditor 0.0 — extract raw:\"0,25%\" only, compare via Code+Graph, fallback PERLU_VERIFIKASI_MANUAL", "output": "substantive_evaluations[] + raw_percent", "fallback": "PERLU_VERIFIKASI_MANUAL", "handles": {"inputs": ["references"], "output": "raw_percent"}}},
    {"id": "risk_synthesizer", "type": "Prompt", "display": "WARDEN-RiskSynthesizer 0.1", "position": {"x": 200, "y": 1040}, "data": {"temp": 0.1, "prompt": "WARDEN-RiskSynthesizer 0.1 — risk_level HIGH|MEDIUM|LOW|PERLU + draft_recommendation + Preliminary Advisory, regex fallback", "output": "risk_level + draft + Preliminary Advisory", "fallback": "regex JSON", "handles": {"inputs": ["verified", "ceiling"], "output": "risk"}}},
    {"id": "sheets_write", "type": "Tool", "display": "Tool — Sheets 9 kolom", "position": {"x": 200, "y": 1180}, "data": {"tool": "generate_compliance_remediation_log", "cols": 9, "cols_name": "Timestamp|Dokumen|Klausul|Jenis|Nilai|Batas|Risiko|Rekomendasi|Reviewer", "handles": {"input": "risk", "output": "sheets_row"}}},
    {"id": "router_high", "type": "ConditionalRouter", "display": "Router — HIGH only", "position": {"x": 200, "y": 1320}, "data": {"condition": "risk_level==HIGH", "then": "webhook", "else": "skipped", "handles": {"input": "sheets_row", "outputs": ["HIGH", "skipped"]}}},
    {"id": "api_readback", "type": "APIRequest", "display": "API Request — Sheets REJECT re-route + cost_avoided", "position": {"x": 0, "y": 1460}, "data": {"poll": "Sheets Reviewer col REJECT→re-route", "cost": "cost_avoided docs*35jt*0.85", "handles": {"input": "sheets_row", "output": "hitl"}}},
    {"id": "webhook", "type": "Webhook", "display": "Webhook — HIGH only", "position": {"x": 400, "y": 1460}, "data": {"trigger": "HIGH only", "handles": {"input": "HIGH", "output": "notified"}}},
    {"id": "chat_output", "type": "ChatOutput", "display": "Chat Output — strict JSON + cost_avoided", "position": {"x": 200, "y": 1600}, "data": {"strict_json": true, "include": "audit_summary+findings+impact cost_avoided", "handles": {"inputs": ["hitl", "notified"], "output": "json"}}}
  ],
  "edges": [
    {"id": "e1", "source": "chat_input", "sourceHandle": "output", "target": "router_entry", "targetHandle": "input"},
    {"id": "e2", "source": "router_entry", "sourceHandle": "audit", "target": "pii_code", "targetHandle": "input"},
    {"id": "e3a", "source": "pii_code", "sourceHandle": "output", "target": "vector_sop", "targetHandle": "input"},
    {"id": "e3b", "source": "pii_code", "sourceHandle": "output", "target": "vector_padk", "targetHandle": "input"},
    {"id": "e4a", "source": "vector_sop", "sourceHandle": "output", "target": "ref_mapper", "targetHandle": "docs_sop"},
    {"id": "e4b", "source": "vector_padk", "sourceHandle": "output", "target": "ref_mapper", "targetHandle": "docs_padk"},
    {"id": "e5", "source": "ref_mapper", "sourceHandle": "output", "target": "rule_auditor", "targetHandle": "inputs"},
    {"id": "e6", "source": "rule_auditor", "sourceHandle": "output", "target": "code_ceiling", "targetHandle": "input"},
    {"id": "e7a", "source": "code_ceiling", "sourceHandle": "output", "target": "graph_lookup", "targetHandle": "input"},
    {"id": "e7b", "source": "code_ceiling", "sourceHandle": "output", "target": "risk_synthesizer", "targetHandle": "verified"},
    {"id": "e7c", "source": "graph_lookup", "sourceHandle": "output", "target": "risk_synthesizer", "targetHandle": "ceiling"},
    {"id": "e8", "source": "risk_synthesizer", "sourceHandle": "output", "target": "sheets_write", "targetHandle": "input"},
    {"id": "e9", "source": "sheets_write", "sourceHandle": "output", "target": "router_high", "targetHandle": "input"},
    {"id": "e10a", "source": "router_high", "sourceHandle": "HIGH", "target": "webhook", "targetHandle": "input"},
    {"id": "e10b", "source": "sheets_write", "sourceHandle": "output", "target": "api_readback", "targetHandle": "input"},
    {"id": "e11a", "source": "api_readback", "sourceHandle": "output", "target": "chat_output", "targetHandle": "hitl"},
    {"id": "e11b", "source": "webhook", "sourceHandle": "output", "target": "chat_output", "targetHandle": "notified"}
  ],
  "mcp": {
    "endpoint": "http://localhost:7860/api/v1/mcp/project/a760286c-db9f-406b-bb95-4d2121592e5e/streamable",
    "transport": "streamablehttp",
    "tools": ["audit_sop_regulatory_reference", "evaluate_rate_cap_substance", "generate_compliance_remediation_log"],
    "persona_tools": ["audit_severity", "draft_remediation"]
  },
  "env": {
    "GOOGLE_API_KEY": "${GOOGLE_API_KEY}",
    "LANGFLOW_API_KEY": "${LANGFLOW_API_KEY}",
    "VECTOR_STORE": "${VECTOR_STORE}",
    "SHEETS_ID": "${SHEETS_ID}",
    "SHEETS_WEBHOOK_URL": "${SHEETS_WEBHOOK_URL}"
  }
}
